# Multi-Browser SMS Configuration

# === TIMING SETTINGS ===
# Delay between messages (seconds)
MIN_DELAY=3
MAX_DELAY=8

# Stagger start delay between browsers (seconds)
BROWSER_START_DELAY=2

# === SAFETY LIMITS ===
# Daily message limit per session
DAILY_MESSAGE_LIMIT=1000

# Maximum retries for failed messages
MAX_RETRIES=3

# Delay between retries (seconds)
RETRY_DELAY=5

# === BROWSER SETTINGS ===
# Maximum concurrent browsers to use
MAX_CONCURRENT_BROWSERS=10

# Run browsers in headless mode (true/false)
HEADLESS_MODE=false

# === LOGGING ===
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Keep logs for X days
LOG_RETENTION_DAYS=7

# === GOOGLE MESSAGES SETTINGS ===
# Timeout for page loads (seconds)
PAGE_LOAD_TIMEOUT=30

# Timeout for element waits (seconds)
ELEMENT_WAIT_TIMEOUT=10

# Authentication timeout (seconds)
AUTH_TIMEOUT=300

# === PERFORMANCE ===
# Enable performance monitoring
ENABLE_MONITORING=true

# Monitor interval (seconds)
MONITOR_INTERVAL=5